{
  "display_name": "Tela",
  "role": "Hyphal Sheath \u2014 filtration, continuity, persistence",
  "provider": "anthropic",
  "model": "claude-haiku-4-5-20251001",
  "api_key_env": "ANTHROPIC_API_KEY",
  "system_prompt": "tela-system.txt",
  "max_tokens": 2048,
  "daily_budget_usd": 2.0,
  "input_cost_per_mtok": 0.8,
  "output_cost_per_mtok": 4.0,
  "cadence": "hourly",
  "data_sources": [
    {
      "name": "SMHI Stockholm Weather",
      "script": "fetch-weather.sh",
      "description": "Current temperature, humidity, wind, pressure from SMHI open API"
    },
    {
      "name": "Stockholm Daylight",
      "script": "fetch-daylight.py",
      "description": "Sunrise, sunset, daylight duration"
    },
    {
      "name": "Repository Activity",
      "script": "fetch-git-activity.sh",
      "description": "Recent git commits to gaian-chronicle repo"
    }
  ]
}