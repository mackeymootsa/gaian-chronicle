{
  "display_name": "Tela",
  "role": "Hyphal Sheath — filtration, continuity, persistence",
  "provider": "anthropic",
  "model": "claude-haiku-4-5-20251001",
  "api_key_env": "ANTHROPIC_API_KEY",
  "system_prompt": "tela-system.txt",
  "max_tokens": 2048,
  "daily_budget_usd": 2.0,
  "input_cost_per_mtok": 0.8,
  "output_cost_per_mtok": 4.0,
  "cadence": "hourly",
  "inquiry_enabled": true,
  "core_docs": [
    "quadrumvirate/charter.md",
    "care/lingua-gaiana.md"
  ],
  "data_sources": [
    {
      "name": "Organism Metabolism",
      "script": "fetch-metabolism.sh",
      "format": "json",
      "epistemic_tag": "DERIVED",
      "description": "Read-only body, estimated spend, storage, and aggregate SSH journal measurements"
    },
    {
      "name": "SMHI Stockholm Weather",
      "script": "fetch-weather.sh",
      "epistemic_tag": "FETCHED",
      "description": "Current temperature, humidity, wind, pressure from SMHI open API"
    },
    {
      "name": "Stockholm Daylight",
      "script": "fetch-daylight.py",
      "epistemic_tag": "DERIVED",
      "description": "Sunrise, sunset, daylight duration"
    },
    {
      "name": "Repository Activity",
      "script": "fetch-git-activity.sh",
      "epistemic_tag": "FETCHED",
      "description": "Recent git commits to gaian-chronicle repo"
    }
  ]
}
